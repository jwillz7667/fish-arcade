# Copy to .env for local development. Placeholder values only; never commit a real .env.

# docker-compose.services.yml (local only, ports bound to 127.0.0.1)
POSTGRES_USER=reef
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reef
REDIS_PASSWORD=change-me
MINIO_ROOT_USER=reef
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# Shared by every app (packages/config: defineEnvSchema)
NODE_ENV=development
LOG_LEVEL=info

# Database roles (pnpm db:roles creates them; production roles come from Terraform)
DATABASE_ADMIN_URL=postgresql://reef:change-me@127.0.0.1:5432/reef
REEF_MIGRATOR_PASSWORD=change-me-migrator
REEF_APP_PASSWORD=change-me-app
REEF_READONLY_PASSWORD=change-me-readonly

# Connection URLs. Production must use TLS: sslmode=verify-full and rediss://.
# Migrations run as reef_migrator; apps connect as reef_app.
MIGRATION_DATABASE_URL=postgresql://reef_migrator:change-me-migrator@127.0.0.1:5432/reef
DATABASE_URL=postgresql://reef_app:change-me-app@127.0.0.1:5432/reef
REDIS_URL=redis://:change-me@127.0.0.1:6379

# Field encryption (packages/crypto-fields). `pnpm keys:dev` writes the local key files.
# Production: FIELD_ENCRYPTION_PROVIDER=kms, FIELD_ENCRYPTION_KMS_KEY_ID, and BLIND_INDEX_KEY
# from Secrets Manager. Local key files are rejected when NODE_ENV=production.
FIELD_ENCRYPTION_PROVIDER=local
FIELD_ENCRYPTION_LOCAL_KEY_FILE=.keys/dev/field-master.key
BLIND_INDEX_KEY_FILE=.keys/dev/blind-index.key

# apps/api
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated exact origins. Never "*". Production requires https.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY_HOPS=0
RATE_LIMIT_PER_MINUTE=300
SHUTDOWN_TIMEOUT_MS=10000

# Player auth (apps/api, playbook Step 6). `pnpm keys:dev` writes the key files.
# Production: AUTH_JWT_PRIVATE_KEY (Ed25519 PKCS#8 PEM) and AUTH_HMAC_KEY (32 bytes, base64)
# inline from Secrets Manager; the *_FILE variants are rejected when NODE_ENV=production.
AUTH_JWT_PRIVATE_KEY_FILE=.keys/dev/auth-jwt.pem
AUTH_JWT_KEY_ID=dev-1
AUTH_HMAC_KEY_FILE=.keys/dev/auth-hmac.key
AUTH_REFRESH_TTL_DAYS=30
# Passkeys: the site's registrable domain and the exact origins that may use it.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Reef
WEBAUTHN_ORIGINS=http://localhost:3000
# Breached-password check via the HIBP range API. Set false only to work offline.
HIBP_ENABLED=true
# Cloudflare's always-pass test secret. Rejected in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Mailpit catches email and SMS in development. No production provider exists yet, so the API
# refuses to start with NODE_ENV=production until one is added.
EMAIL_PROVIDER=mailpit
SMS_PROVIDER=mailpit
MAILPIT_URL=http://127.0.0.1:8025
EMAIL_FROM=no-reply@reef.local

# Geolocation (apps/api, playbook Step 7). Only the dev stub exists; it reads the
# X-Reef-Dev-Geo header and is rejected in production, so production fails closed until a
# vendor adapter (GeoComply, Radar, MaxMind + IPQS) is added.
GEO_PROVIDER=dev_stub
GEO_MIN_CONFIDENCE=0.9
GEO_PROVIDER_TIMEOUT_MS=3000
GEO_TOKEN_TTL_SECONDS=600

# apps/game-server
GAME_SERVER_PORT=4100
