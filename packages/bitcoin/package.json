{
  "name": "@reef/bitcoin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@reef/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "btc:bootstrap": "tsx --env-file-if-exists=../../.env --conditions=@reef/source scripts/bootstrap-regtest.ts",
    "btc:mine": "tsx --env-file-if-exists=../../.env --conditions=@reef/source scripts/mine.ts",
    "btc:fund": "tsx --env-file-if-exists=../../.env --conditions=@reef/source scripts/fund.ts"
  },
  "dependencies": {
    "@reef/errors": "workspace:*",
    "@reef/money": "workspace:*",
    "@scure/bip32": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@reef/config": "workspace:*",
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
