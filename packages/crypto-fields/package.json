{
  "name": "@reef/crypto-fields",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@reef/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "keys:dev": "tsx --conditions=@reef/source scripts/generate-dev-keys.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1164.0",
    "@reef/errors": "workspace:*"
  },
  "devDependencies": {
    "@reef/config": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "tsx": "4.23.15"
  }
}
