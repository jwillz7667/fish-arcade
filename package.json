{
  "name": "reef",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.23.5 <23",
    "pnpm": ">=11.28.11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && turbo run typecheck",
    "test": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose -f docker-compose.services.yml --env-file .env up -d --wait",
    "services:down": "docker compose -f docker-compose.services.yml --env-file .env down",
    "prepare": "husky",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage",
    "db:roles": "pnpm --filter @reef/db db:roles",
    "db:migrate": "pnpm --filter @reef/db db:migrate",
    "db:seed": "pnpm --filter @reef/db db:seed",
    "keys:dev": "pnpm --filter @reef/crypto-fields keys:dev"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@reef/config": "workspace:*",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
