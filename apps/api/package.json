{
  "name": "@reef/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=@reef/source src/main.ts",
    "start": "node dist/main.js",
    "keys:dev": "tsx --conditions=@reef/source scripts/generate-dev-auth-keys.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-fastify": "12.4.0",
    "@nestjs/swagger": "12.1.1",
    "@reef/config": "workspace:*",
    "@reef/crypto-fields": "workspace:*",
    "@reef/errors": "workspace:*",
    "@reef/ledger": "workspace:*",
    "@reef/logger": "workspace:*",
    "@reef/money": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@reef/db": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "fast-check": "4.10.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
