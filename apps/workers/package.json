{
  "name": "@reef/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=@reef/source src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@reef/config": "workspace:*",
    "@reef/errors": "workspace:*",
    "@reef/logger": "workspace:*",
    "@reef/money": "workspace:*",
    "@reef/pricing": "workspace:*",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@reef/db": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
